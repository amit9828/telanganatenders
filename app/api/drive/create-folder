import { NextResponse } from 'next/server';
import { getDb } from '@/lib/db';
import { findOrCreateDriveFolder } from '@/lib/drive';

export async function POST(request) {
  try {
    const { email, folderName } = await request.json();

    if (!email || !folderName) {
      return NextResponse.json({ error: 'Missing client email or folder name' }, { status: 400 });
    }

    // 1. గూగుల్ డ్రైవ్‌లో ఫోల్డర్ క్రియేట్ చేయడం
    const { folderId, folderLink } = await findOrCreateDriveFolder({ folderName });

    // 2. డేటాబేస్ (MongoDB) లో లింక్ సేవ్ చేయడం
    const db = await getDb();
    await db.collection('users').updateOne(
      { email: email.toLowerCase() },
      {
        $set: {
          drive_folder_id: folderId,
          drive_link: folderLink,
          drive_folder_link: folderLink
        }
      }
    );

    return NextResponse.json({ success: true, folderId, folderLink });
  } catch (error) {
    console.error('Drive Folder Creation Error:', error);
    return NextResponse.json({ error: error.message || 'Server Error' }, { status: 500 });
  }
}
